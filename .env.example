# Set a YouTube, HTTP or RTSP URL. Use single quotes if it contains a dollar sign.
TRAFFIC_SOURCE=https://www.youtube.com/watch?v=sTF-6_xinUU
TRAFFIC_CAMERA=cam1
TRAFFIC_FORECAST_MODEL=prophet
TRAFFIC_TIMEZONE=Europe/Budapest
TRAFFIC_MAX_FPS=30
TRAFFIC_MAX_HEIGHT=720

# For a LAN deployment, set the host's LAN IP here and in TRAFFIC_STREAM_URL.
TRAFFIC_BIND_IP=127.0.0.1
TRAFFIC_STREAM_URL=http://127.0.0.1:8002/stream
TRAFFIC_ALLOW_CLEAR=false
